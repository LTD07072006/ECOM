{
  "name": "vietnam-investor-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.5",
  "scripts": {
    "setup:local": "bun run scripts/setup-local.ts",
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src tests scripts",
    "format:check": "biome format src tests scripts",
    "format": "biome format --write src tests scripts",
    "test": "bun test tests/api tests/db tests/features tests/smoke",
    "test:e2e": "playwright test tests/e2e",
    "test:release": "bun run scripts/test-release.ts",
    "test:pilot": "bun run scripts/sprint4-smoke.ts",
    "bench:inquiries": "bun run scripts/benchmark-inquiries.ts",
    "test:db": "bun run scripts/run-db-tests.ts",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/import-release.ts --publish",
    "db:seed:legal": "bun run src/db/seed-legal-readiness.ts",
    "db:import": "bun run src/db/import-release.ts",
    "db:import:wave2": "bun run src/db/import-wave2.ts",
    "db:check": "bun run src/db/check.ts",
    "db:audit:boundaries": "bun run src/db/boundary-audit.ts",
    "db:cleanup:inquiries": "bun run src/db/cleanup-inquiries.ts",
    "db:cleanup:reports": "bun run src/db/cleanup-inquiries.ts",
    "db:retention:monitor": "bun run src/db/cleanup-inquiries.ts --monitor",
    "db:retention:scheduler": "bun run src/db/retention-scheduler.ts",
    "mail:flush": "bun run src/db/flush-mail.ts",
    "mail:scheduler": "bun run src/db/mail-scheduler.ts"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "drizzle-orm": "0.45.4",
    "maplibre-gl": "6.19.0",
    "next": "15.5.29",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "postcss": "8.5.33"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@playwright/test": "1.65.1",
    "@types/bun": "1.4.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
