# See the README for local setup. Keep real values in the ignored .env file.
POSTGRES_PASSWORD=
DATABASE_URL=

# Optional internal release dashboard. Use two different random base64url tokens.
RELEASE_REVIEWER_TOKEN=
RELEASE_STEWARD_TOKEN=
# Set to 1 on every staging and production importer.
REQUIRE_RELEASE_APPROVAL=

# Required for public inquiry collection in production. Supply the real controller and contact.
INQUIRY_PRIVACY_CONTROLLER=
INQUIRY_PRIVACY_EMAIL=

# Public ingress only. Keep this server-side and inject it at the trusted reverse proxy.
ECOM_TRUSTED_PROXY_TOKEN=
