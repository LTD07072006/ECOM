# See the README for local setup. Keep real values in the ignored .env file.
POSTGRES_PASSWORD=
DATABASE_URL=

# Optional internal release dashboard. Use two different random base64url tokens.
RELEASE_REVIEWER_TOKEN=
RELEASE_STEWARD_TOKEN=
# Set to 1 on every staging and production importer.
REQUIRE_RELEASE_APPROVAL=

# Required for public inquiry collection in production. Supply the real controller and contact.
INQUIRY_PRIVACY_CONTROLLER=
INQUIRY_PRIVACY_EMAIL=

# Public ingress only. Keep this server-side and inject it at the trusted reverse proxy.
ECOM_TRUSTED_PROXY_TOKEN=

# Host loopback port mapped to PostgreSQL in Docker Compose (default 55432).
ECOM_DB_PORT=
# Fallback PostgreSQL password used by the retention service to build DATABASE_URL when unset (see src/lib/env.ts).
ECOM_RETENTION_DB_PASSWORD=

# JSON array of named operators ([{"id","role","token"}]) stored in a secret manager for staging/production.
ECOM_OPERATORS=
# Set to 1 in staging and production to require named operators instead of shared release tokens.
ECOM_REQUIRE_NAMED_OPERATORS=
# Optional secret (>=32 chars) mixed into HMAC signing keys for operator session cookies.
ECOM_SESSION_SECRET=

# Destination email address for steward alerts when new investor inquiries arrive.
ECOM_STEWARD_NOTIFY_EMAIL=
# Transactional mail transport: log, resend, or disabled (defaults to log locally, disabled in production).
ECOM_MAIL_TRANSPORT=
# Sender email address required when ECOM_MAIL_TRANSPORT=resend.
ECOM_MAIL_FROM=
# Resend API key used to deliver transactional mail when ECOM_MAIL_TRANSPORT=resend.
RESEND_API_KEY=
# Mail scheduler polling interval in ms after a successful flush (default 60000, minimum 5000).
ECOM_MAIL_FLUSH_INTERVAL_MS=
# Mail scheduler backoff delay in ms after a failed flush (default 300000, minimum 5000).
ECOM_MAIL_ERROR_BACKOFF_MS=
